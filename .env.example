# Create and activate a sandbox application at https://law.lexmachina.com/api-settings.
LEX_MACHINA_CLIENT_ID=replace-with-your-client-id
LEX_MACHINA_CLIENT_SECRET=replace-with-your-client-secret
LEX_MACHINA_BASE_URL=https://api.sandbox.lexmachina.com

# Credentials use form-body (default) or HTTP Basic. Query mode is rejected.
LEX_MACHINA_TOKEN_AUTH_METHOD=form

